generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql" url = env("DATABASE_URL") }

enum Role { ADMIN HOD FACULTY STUDENT }
enum ResourceType { CLASSROOM LAB WORKSHOP SEMINAR_HALL AUDITORIUM }
enum SessionType { LECTURE PRACTICAL TUTORIAL WORKSHOP SEMINAR }
enum AvailabilityKind { AVAILABLE UNAVAILABLE PREFERRED AVOID }
enum RuleStrength { HARD SOFT }
enum TimetableStatus { DRAFT GENERATED VALIDATED REVIEWED APPROVED PUBLISHED ARCHIVED }
enum RunStatus { QUEUED BUILDING_CANDIDATES SOLVING VALIDATING SUCCEEDED INFEASIBLE FAILED }

model User { id String @id @default(uuid()) email String @unique passwordHash String? name String role Role @default(STUDENT) departmentId String? department Department? @relation(fields:[departmentId],references:[id]) faculty Faculty? auditEvents AuditEvent[] createdAt DateTime @default(now()) updatedAt DateTime @updatedAt }
model AcademicYear { id String @id @default(uuid()) name String @unique startsOn DateTime endsOn DateTime active Boolean @default(true) programs Program[] scheduleProfiles ScheduleProfile[] timetables Timetable[] createdAt DateTime @default(now()) updatedAt DateTime @updatedAt }
model Department { id String @id @default(uuid()) code String @unique name String @unique active Boolean @default(true) users User[] programs Program[] faculty Faculty[] subjects Subject[] resources Resource[] zones Zone[] createdAt DateTime @default(now()) updatedAt DateTime @updatedAt }
model Program { id String @id @default(uuid()) code String name String departmentId String department Department @relation(fields:[departmentId],references:[id]) academicYearId String academicYear AcademicYear @relation(fields:[academicYearId],references:[id]) levels AcademicLevel[] subjects Subject[] @@unique([academicYearId,code]) @@index([departmentId]) }
model AcademicLevel { id String @id @default(uuid()) name String ordinal Int programId String program Program @relation(fields:[programId],references:[id],onDelete:Cascade) divisions Division[] subjects Subject[] @@unique([programId,ordinal]) }
model Division { id String @id @default(uuid()) name String enrollmentCount Int programLevelId String programLevel AcademicLevel @relation(fields:[programLevelId],references:[id],onDelete:Cascade) batches Batch[] enrollments Enrollment[] requirementCohorts RequirementCohort[] @@unique([programLevelId,name]) }
model Batch { id String @id @default(uuid()) name String enrollmentCount Int divisionId String division Division @relation(fields:[divisionId],references:[id],onDelete:Cascade) enrollments Enrollment[] requirementCohorts RequirementCohort[] @@unique([divisionId,name]) }
model Student { id String @id @default(uuid()) rollNumber String @unique name String enrollments Enrollment[] }
model Enrollment { id String @id @default(uuid()) studentId String student Student @relation(fields:[studentId],references:[id]) divisionId String division Division @relation(fields:[divisionId],references:[id]) batchId String? batch Batch? @relation(fields:[batchId],references:[id]) validFrom DateTime validTo DateTime? @@unique([studentId,divisionId,validFrom]) @@index([divisionId,batchId]) }

model Faculty { id String @id @default(uuid()) employeeCode String @unique name String email String @unique departmentId String department Department @relation(fields:[departmentId],references:[id]) userId String? @unique user User? @relation(fields:[userId],references:[id]) active Boolean @default(true) maxPeriodsPerWeek Int? maxConsecutivePeriods Int? eligibility FacultySubjectEligibility[] availability FacultyAvailability[] preferences FacultyPreference[] requirements TeachingRequirement[] createdAt DateTime @default(now()) updatedAt DateTime @updatedAt }
model FacultySubjectEligibility { facultyId String faculty Faculty @relation(fields:[facultyId],references:[id],onDelete:Cascade) subjectId String subject Subject @relation(fields:[subjectId],references:[id],onDelete:Cascade) sessionType SessionType? active Boolean @default(true) @@id([facultyId,subjectId]) }
model FacultyAvailability { id String @id @default(uuid()) facultyId String faculty Faculty @relation(fields:[facultyId],references:[id],onDelete:Cascade) workingDayId String workingDay WorkingDay @relation(fields:[workingDayId],references:[id]) timeSlotId String? timeSlot TimeSlot? @relation(fields:[timeSlotId],references:[id]) kind AvailabilityKind reason String? @@unique([facultyId,workingDayId,timeSlotId,kind]) @@index([facultyId,workingDayId]) }
model FacultyPreference { id String @id @default(uuid()) facultyId String faculty Faculty @relation(fields:[facultyId],references:[id],onDelete:Cascade) type String weight Int @default(10) parameters Json active Boolean @default(true) }

model Subject { id String @id @default(uuid()) code String name String departmentId String department Department @relation(fields:[departmentId],references:[id]) programId String? program Program? @relation(fields:[programId],references:[id]) academicLevelId String? academicLevel AcademicLevel? @relation(fields:[academicLevelId],references:[id]) semester Int? active Boolean @default(true) eligibility FacultySubjectEligibility[] requirements TeachingRequirement[] @@unique([departmentId,code]) }
model TeachingRequirement { id String @id @default(uuid()) subjectId String subject Subject @relation(fields:[subjectId],references:[id]) facultyId String faculty Faculty @relation(fields:[facultyId],references:[id]) sessionType SessionType durationPeriods Int weeklyFrequency Int resourceType ResourceType minCapacity Int? requiredResourceId String? requiredResource Resource? @relation("RequiredResource",fields:[requiredResourceId],references:[id]) active Boolean @default(true) preferences Json? cohorts RequirementCohort[] capabilities RequirementCapability[] sessions SchedulableSession[] createdAt DateTime @default(now()) updatedAt DateTime @updatedAt @@index([subjectId,facultyId]) }
model RequirementCohort { id String @id @default(uuid()) requirementId String requirement TeachingRequirement @relation(fields:[requirementId],references:[id],onDelete:Cascade) divisionId String? division Division? @relation(fields:[divisionId],references:[id]) batchId String? batch Batch? @relation(fields:[batchId],references:[id]) @@unique([requirementId,divisionId,batchId]) @@index([divisionId,batchId]) }
model RequirementCapability { requirementId String requirement TeachingRequirement @relation(fields:[requirementId],references:[id],onDelete:Cascade) capabilityId String capability Capability @relation(fields:[capabilityId],references:[id]) required Boolean @default(true) weight Int @default(5) @@id([requirementId,capabilityId]) }

model Building { id String @id @default(uuid()) code String @unique name String active Boolean @default(true) floors Floor[] }
model Floor { id String @id @default(uuid()) name String ordinal Int buildingId String building Building @relation(fields:[buildingId],references:[id],onDelete:Cascade) zones Zone[] resources Resource[] @@unique([buildingId,ordinal]) }
model Zone { id String @id @default(uuid()) name String floorId String floor Floor @relation(fields:[floorId],references:[id]) departmentId String? department Department? @relation(fields:[departmentId],references:[id]) resources Resource[] @@unique([floorId,name]) }
model Resource { id String @id @default(uuid()) code String @unique name String type ResourceType capacity Int active Boolean @default(true) departmentId String? department Department? @relation(fields:[departmentId],references:[id]) floorId String? floor Floor? @relation(fields:[floorId],references:[id]) zoneId String? zone Zone? @relation(fields:[zoneId],references:[id]) capabilities ResourceCapability[] availability ResourceAvailability[] requirements TeachingRequirement[] @relation("RequiredResource") entries TimetableEntry[] createdAt DateTime @default(now()) updatedAt DateTime @updatedAt @@index([type,active,capacity]) }
model Capability { id String @id @default(uuid()) key String @unique name String resources ResourceCapability[] requirements RequirementCapability[] }
model ResourceCapability { resourceId String resource Resource @relation(fields:[resourceId],references:[id],onDelete:Cascade) capabilityId String capability Capability @relation(fields:[capabilityId],references:[id]) @@id([resourceId,capabilityId]) }
model ResourceAvailability { id String @id @default(uuid()) resourceId String resource Resource @relation(fields:[resourceId],references:[id],onDelete:Cascade) workingDayId String workingDay WorkingDay @relation(fields:[workingDayId],references:[id]) timeSlotId String? timeSlot TimeSlot? @relation(fields:[timeSlotId],references:[id]) kind AvailabilityKind reason String? @@unique([resourceId,workingDayId,timeSlotId,kind]) }

model ScheduleProfile { id String @id @default(uuid()) name String academicYearId String academicYear AcademicYear @relation(fields:[academicYearId],references:[id]) active Boolean @default(true) workingDays WorkingDay[] timetables Timetable[] @@unique([academicYearId,name]) }
model WorkingDay { id String @id @default(uuid()) profileId String profile ScheduleProfile @relation(fields:[profileId],references:[id],onDelete:Cascade) name String ordinal Int enabled Boolean @default(true) slots TimeSlot[] facultyAvailability FacultyAvailability[] resourceAvailability ResourceAvailability[] @@unique([profileId,ordinal]) }
model TimeSlot { id String @id @default(uuid()) workingDayId String workingDay WorkingDay @relation(fields:[workingDayId],references:[id],onDelete:Cascade) index Int label String startsAt String endsAt String isBreak Boolean @default(false) facultyAvailability FacultyAvailability[] resourceAvailability ResourceAvailability[] entrySlots TimetableEntrySlot[] @@unique([workingDayId,index]) }

model SchedulingPolicy { id String @id @default(uuid()) name String description String ruleType String strength RuleStrength priority Int @default(10) scope Json parameters Json active Boolean @default(true) version Int @default(1) effectiveFrom DateTime? effectiveTo DateTime? createdById String? createdAt DateTime @default(now()) updatedAt DateTime @updatedAt @@index([active,ruleType]) }
model SchedulableSession { id String @id @default(uuid()) requirementId String requirement TeachingRequirement @relation(fields:[requirementId],references:[id]) occurrence Int durationPeriods Int fingerprint String @unique entries TimetableEntry[] @@unique([requirementId,occurrence]) }
model Timetable { id String @id @default(uuid()) name String academicYearId String academicYear AcademicYear @relation(fields:[academicYearId],references:[id]) profileId String profile ScheduleProfile @relation(fields:[profileId],references:[id]) versions TimetableVersion[] createdAt DateTime @default(now()) @@index([academicYearId]) }
model TimetableVersion { id String @id @default(uuid()) timetableId String timetable Timetable @relation(fields:[timetableId],references:[id],onDelete:Cascade) version Int status TimetableStatus @default(DRAFT) parentVersionId String? publishedAt DateTime? approvedById String? entries TimetableEntry[] runs GenerationRun[] validations ValidationResult[] createdAt DateTime @default(now()) updatedAt DateTime @updatedAt @@unique([timetableId,version]) @@index([status]) }
model TimetableEntry { id String @id @default(uuid()) versionId String version TimetableVersion @relation(fields:[versionId],references:[id],onDelete:Cascade) sessionId String session SchedulableSession @relation(fields:[sessionId],references:[id]) resourceId String resource Resource @relation(fields:[resourceId],references:[id]) source String @default("SOLVER") locked Boolean @default(false) slots TimetableEntrySlot[] @@unique([versionId,sessionId]) @@index([resourceId]) }
model TimetableEntrySlot { entryId String entry TimetableEntry @relation(fields:[entryId],references:[id],onDelete:Cascade) timeSlotId String timeSlot TimeSlot @relation(fields:[timeSlotId],references:[id]) ordinal Int @@id([entryId,timeSlotId]) @@index([timeSlotId]) }
model GenerationRun { id String @id @default(uuid()) versionId String? version TimetableVersion? @relation(fields:[versionId],references:[id]) status RunStatus @default(QUEUED) scope Json? sessionCount Int @default(0) candidateCount Int @default(0) solverStatus String? solverDurationMs Int? objectiveMetrics Json? diagnostics Json? startedAt DateTime @default(now()) completedAt DateTime? }
model ValidationResult { id String @id @default(uuid()) versionId String version TimetableVersion @relation(fields:[versionId],references:[id],onDelete:Cascade) valid Boolean conflicts Conflict[] metrics Json checkedAt DateTime @default(now()) }
model Conflict { id String @id @default(uuid()) validationId String validation ValidationResult @relation(fields:[validationId],references:[id],onDelete:Cascade) code String severity String message String evidence Json? sessionIds String[] resolvedAt DateTime? @@index([code]) }

model Conversation { id String @id @default(uuid()) userId String title String? messages ConversationMessage[] actions AIAction[] createdAt DateTime @default(now()) updatedAt DateTime @updatedAt }
model ConversationMessage { id String @id @default(uuid()) conversationId String conversation Conversation @relation(fields:[conversationId],references:[id],onDelete:Cascade) role String content String createdAt DateTime @default(now()) }
model AIAction { id String @id @default(uuid()) conversationId String conversation Conversation @relation(fields:[conversationId],references:[id],onDelete:Cascade) tool String arguments Json result Json? status String confirmationRequired Boolean @default(false) confirmedAt DateTime? createdAt DateTime @default(now()) }
model AuditEvent { id String @id @default(uuid()) actorId String? actor User? @relation(fields:[actorId],references:[id]) action String entityType String entityId String? before Json? after Json? ipAddress String? createdAt DateTime @default(now()) @@index([entityType,entityId]) }
