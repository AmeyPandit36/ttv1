{
  "name": "campus-chronos",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm:dev -w @chronos/api\" \"npm:dev -w @chronos/web\"",
    "build": "npm run build -w @chronos/domain && npm run build -w @chronos/api && npm run build -w @chronos/web",
    "test": "npm run test -w @chronos/domain && npm run test -w @chronos/api && .venv/bin/python -m unittest discover scheduler/tests",
    "typecheck": "tsc -b",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts"
  },
  "devDependencies": {
    "@prisma/client": "6.14.0",
    "concurrently": "9.2.0",
    "prisma": "6.14.0",
    "tsx": "4.20.4",
    "typescript": "5.9.2",
    "vitest": "3.2.4"
  }
}
