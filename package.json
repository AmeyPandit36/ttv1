{
  "name": "campus-chronos",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "CHRONOS_SEED_DEMO=1 concurrently -n api,web -c blue,green \"npm:dev -w @chronos/api\" \"npm:dev -w @chronos/web\"",
    "build": "npm run build -w @chronos/domain && npm run build -w @chronos/api && npm run build -w @chronos/web",
    "test": "npm run test -w @chronos/domain && npm run test -w @chronos/api && .venv/bin/python -m unittest discover scheduler/tests",
    "typecheck": "tsc -b",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@prisma/client": "6.14.0",
    "@types/pg": "^8.23.1",
    "concurrently": "9.2.0",
    "pg": "^8.23.0",
    "prisma": "6.14.0",
    "tsx": "4.20.4",
    "typescript": "5.9.2",
    "vitest": "3.2.4"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.3.14",
    "@types/pdfkit": "^0.17.6",
    "bcryptjs": "^3.0.2",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.1.0",
    "jose": "^6.1.0",
    "pdfkit": "^0.19.1",
    "xlsx": "^0.18.5"
  }
}
